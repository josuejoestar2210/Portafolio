<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de Josue Aaron - Desarrollador Full Stack especializado en .NET, ASP.NET Core, Entity Framework y SQL Server" />
    <meta name="keywords" content="Desarrollador .NET, ASP.NET Core, Full Stack, C#, SQL Server, Entity Framework" />
    <meta name="author" content="Josue Aaron" />

    <title>@ViewData["Title"] - Josue Aaron Portfolio</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/portfolio.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="header-flotante">
        <nav class="nav-pill">
            <a class="nav-pill-link" asp-controller="Home" asp-action="Index">Inicio</a>
            <a class="nav-pill-link" asp-controller="Home" asp-action="Experiencia">Experiencia</a>
            <a class="nav-pill-link" asp-controller="Home" asp-action="Proyectos">Proyectos</a>
            <a class="nav-pill-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-oscuro py-3 mt-5">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Josue Aaron. Todos los derechos reservados.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/portfolio.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
